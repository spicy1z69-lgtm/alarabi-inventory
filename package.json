{
  "name": "alarabi-inventory",
  "private": true,
  "version": "1.1.4",
  "description": "نظام العربي لإدارة المخزون والمبيعات والفواتير",
  "author": "AlArabi Earthing Systems",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "node --test",
    "preview": "vite preview --host 0.0.0.0",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "desktop:build": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "^13.0.3",
    "exceljs": "^4.4.0",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.0.12",
    "typescript": "latest",
    "wait-on": "^8.0.4"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "build": {
    "appId": "com.alarabi.inventory",
    "productName": "alarabisystem",
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "better-sqlite3": true,
    "electron": true,
    "electron-winstaller": true
  }
}
